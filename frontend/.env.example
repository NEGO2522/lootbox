# ─────────────────────────────────────────────────────────────
# LootChest Frontend — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env or .env.local to git
# ─────────────────────────────────────────────────────────────

# Your deployed Move package address (from: sui client publish)
VITE_PACKAGE_ID=0xYOUR_PACKAGE_ID_HERE

# Sui network: testnet | devnet | mainnet
VITE_NETWORK=testnet

# RPC endpoint for the selected network
VITE_RPC_URL=https://fullnode.testnet.sui.io:443

# App name shown in wallet connection modal
VITE_APP_NAME=LootChest
